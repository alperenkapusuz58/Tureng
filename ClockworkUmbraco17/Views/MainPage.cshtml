@inherits UmbracoViewPage<MainPage>
@using ClockworkUmbraco.Controllers
@{
    Layout = "Layout.cshtml";
    var siteSettings = Model?.GetSiteSettings();
    var dictionarySearchUrl = Url.Action(nameof(SearchController.Search), nameof(SearchController).Replace("Controller", "", StringComparison.Ordinal)) ?? "/api/dictionary/search";
}

<section class="hero">
    <div class="hero-inner">
        <div class="brand-panel">
            <div class="crest">
                @if (siteSettings?.FooterLogo != null)
                {
                    <img src="@siteSettings.FooterLogo.Url()" alt="@Model?.Name" width="54" height="54">
                }
            </div>
        </div>

        <div class="search-card">
            <form method="get" action="#" id="dict-search-form" data-dictionary-search-url="@dictionarySearchUrl" autocomplete="off">
                <input type="hidden" name="direction" id="direction" value="en-tr">
                <div class="search-wrap">
                    <div class="search-shell">
                        <input type="text" id="query" name="q" autocomplete="off" placeholder="Search English" required>
                        <button class="search-submit" type="submit" aria-label="Ara">
                            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8" />
                                <line x1="21" y1="21" x2="16.65" y2="16.65" />
                            </svg>
                        </button>
                    </div>
                    <ul class="suggestions" id="suggestions" role="listbox" aria-label="Arama önerileri" hidden></ul>
                    <template id="dictionary-suggestion-item-template">
                        <li role="option"><a href="#"></a></li>
                    </template>
                </div>

                <div class="tabs">
                    <button type="button" class="tab-btn active" data-direction="en-tr">@Umbraco.GetDictionaryValue("Common.English-Turkish")</button>
                    <button type="button" class="tab-btn" data-direction="tr-en">@Umbraco.GetDictionaryValue("Common.Turkish-English")</button>
                </div>
            </form>
        </div>
    </div>
</section>

<div class="page">
</div>

@section scripts {
    <script src="~/js/dictionary-search.js" asp-append-version="true"></script>
}
