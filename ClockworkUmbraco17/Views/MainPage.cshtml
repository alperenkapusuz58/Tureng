@inherits UmbracoViewPage<MainPage>
@using ClockworkUmbraco.Helpers
@using ClockworkUmbraco.Services.Interfaces
@using Umbraco.Cms.Web.Common.PublishedModels
@inject IWordOfTheDayService WordOfTheDayService

@{

    Layout = "Layout.cshtml";


    var today = DateTime.Now;

    var wordOfDay = WordOfTheDayService.GetWordOfTheDay(today);

    var wotdLabel = Umbraco.GetDictionaryValue("Common.GununKelimesi");

    var englishCulture = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
}

<div class="home-page">
    <section class="home-content">
        <div class="home-cards">
            <article class="home-feature-card">
                <div class="home-feature-card__body">
                    <h2 class="home-feature-card__title">
                        @Model.CardTitle
                    </h2>
                    <p class="home-feature-card__text">
                        @Model.CardDescription
                    </p>
                    @if (Model.CardUrl != null)
                    {
                        <a class="home-feature-card__url" href="@Model.CardUrl.Url" target="@Model.CardUrl.Target" rel="noopener noreferrer">@Model.CardUrl.Name</a>
                    }
                </div>
                <div class="home-feature-card__logo">
                    <div class="home-feature-card__logo-slot" aria-hidden="true">
                        @if (Model.CardImage != null)
                        {
                            <img src="@Model.CardImage.Url()" alt="@Model.CardImage.Name" />
                        }
                    </div>
                </div>
            </article>

            @if (wordOfDay != null)
            {
                var firstTranslation = HeadwordDisplay.FirstTranslation(wordOfDay);

                <a class="home-wotd-card home-wotd-card--link" href="@wordOfDay.Url()" aria-label="@($"{wotdLabel}: {wordOfDay.Word}")">
                    <div class="home-wotd-card__top">
                        <time class="home-wotd-card__date" datetime="@today.ToString("yyyy-MM-dd")">@today.ToString("d MMMM yyyy", englishCulture)</time>
                        <span class="home-wotd-card__tag">@wotdLabel</span>
                    </div>

                    <div class="home-wotd-card__word-row">
                        <span class="home-wotd-card__word">@wordOfDay.Word</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(firstTranslation))
                    {
                        <p class="home-wotd-card__translation">@firstTranslation</p>
                    }

                    <span class="home-wotd-card__cta">Detaya git →</span>
                </a>
            }
            else
            {
                <article class="home-wotd-card">
                    <div class="home-wotd-card__top">
                        <time class="home-wotd-card__date" datetime="@today.ToString("yyyy-MM-dd")">@today.ToString("d MMMM yyyy", englishCulture)</time>
                        <span class="home-wotd-card__tag">@wotdLabel</span>
                    </div>
                </article>
            }

        </div>

    </section>


    @if (Model.Spotlights != null && Model.Spotlights.Any())
    {
        <section class="home-spotlights" aria-label="Keşfet">

            <div class="home-spotlights__inner">

                @for (var i = 0; i < Model.Spotlights.Count; i++)
                {
                    var spotlight = Model.Spotlights.ElementAt(i).Content as ImageTitleDescriptionUrlItem;

                    <article class="home-spotlight-card">
                        @if (spotlight?.Image != null)
                        {
                            <div class="home-spotlight-card__illus home-spotlight-card__illus--lists" aria-hidden="true">
                                <img src="@spotlight.Image.Url()" alt="@spotlight.Image.Name" />
                            </div>
                        }

                        <div class="home-spotlight-card__body">
                            <h2 class="home-spotlight-card__title">@spotlight?.Title</h2>
                            <p class="home-spotlight-card__text">
                                @Html.Raw(spotlight?.Description)
                            </p>
                            @if (spotlight?.Url != null)
                            {
                                <a class="home-spotlight-card__link" href="@spotlight.Url.Url" target="@spotlight.Url.Target" rel="noopener noreferrer">@spotlight.Url.Name</a>
                            }
                        </div>
                    </article>
                }


            </div>

        </section>
    }

    <section class="site-promo-banner" aria-label="YouTube kanalı">
        <div class="site-promo-banner__inner">
            @if (Model.Url != null)
            {
                <a class="site-promo-banner__link"
                   href="@Model.Url.Url"
                   target="@Model.Url.Target"
                   rel="noopener noreferrer">
                    @if (Model.Image != null)
                    {
                        <img class="site-promo-banner__image"
                             src="@Model.Image.Url()"
                             alt="@Model.Image.Name"
                             width="1160"
                             height="200"
                             loading="lazy" />
                    }
                </a>
            }

        </div>
    </section>

</div>

