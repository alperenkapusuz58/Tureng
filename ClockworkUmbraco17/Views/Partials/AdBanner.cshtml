@using System.IO
@using ClockworkUmbraco.Extensions
@inherits UmbracoViewPage
@inject IWebHostEnvironment WebHostEnvironment

@{
    var siteSettings = Model.GetSiteSettings();
    var youtubeLink = siteSettings?.HeaderSocialLinks?
        .FirstOrDefault(link => string.Equals(link?.Network, "youtube", StringComparison.OrdinalIgnoreCase));

    var promoUrl = youtubeLink?.Url?.Trim();
    var promoImageUrl = ResolvePromoImageUrl();
}

@if (!string.IsNullOrWhiteSpace(promoUrl) && !string.IsNullOrWhiteSpace(promoImageUrl))
{
    <aside class="site-promo-banner" role="complementary" aria-label="YouTube kanalı">
        <div class="site-promo-banner__inner">
            <a class="site-promo-banner__link"
               href="@promoUrl"
               target="_blank"
               rel="noopener noreferrer">
                <img class="site-promo-banner__image"
                     src="@promoImageUrl"
                     alt="YouTube kanalımızı ziyaret edin"
                     width="728"
                     height="90"
                     loading="lazy"
                     decoding="async" />
            </a>
        </div>
    </aside>
}

@functions {
    private string? ResolvePromoImageUrl()
    {
        var imageNames = new[] { "youtube-promo.jpg", "youtube-promo.png", "youtube-promo.webp", "youtube-promo.svg" };

        foreach (var imageName in imageNames)
        {
            var physicalPath = System.IO.Path.Combine(WebHostEnvironment.WebRootPath, "images", imageName);
            if (System.IO.File.Exists(physicalPath))
            {
                return Url.Content($"~/images/{imageName}");
            }
        }

        return null;
    }
}
