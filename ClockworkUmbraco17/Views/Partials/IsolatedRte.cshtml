@model string

@if (!string.IsNullOrWhiteSpace(Model))
{
    <span class="rte-isolated">
        <template shadowrootmode="open">
            <style>
                :host { display: contents; }
                b, strong { font-size: 15px; font-weight: 700; }
                p { margin: 0; }
                p + p { margin-top: 2px; }
            </style>
            @Html.Raw(Model)
        </template>
    </span>
}
