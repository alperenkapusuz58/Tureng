@model string

@if (!string.IsNullOrWhiteSpace(Model))
{
    <span class="rte-isolated">
        <template shadowrootmode="open">
            <style>
                :host {
                    display: contents;
                    font-family: "Manrope", Arial, sans-serif;
                    font-size: 14px;
                }
                b, strong { font-size: 14px; font-weight: 700; }
                p { margin: 0; }
                p + p { margin-top: 2px; }
            </style>
            @Html.Raw(Model)
        </template>
    </span>
}
