@using Umbraco.Cms.Core.Services
@using ClockworkUmbraco.Controllers
@inherits UmbracoViewPage
@inject ILanguageService LanguageService

@{
    var siteSettings = Model.GetSiteSettings();
    var home = Model.GetMainPage();

    var dictionarySearchUrl = Url.Action(nameof(SearchController.Search), nameof(SearchController).Replace("Controller", "", StringComparison.Ordinal));
    var dictionaryNoResultsUrl = Model.GetDictionaryNoResults()?.Url() ?? string.Empty;
}

<header class="site-header">
    <div class="site-header__inner page">
        @if (home != null)  {
            <a class="site-header__logo" href="@home.Url()">
                @if(siteSettings.HeaderLogo != null) {
                <img src="@siteSettings.HeaderLogo.Url()" alt="@siteSettings.HeaderLogo.Name" height="48" />

                }
            </a>
        }


        <div class="site-header__end">
            <button type="button"
                    class="site-header__menu-toggle"
                    data-site-menu-open
                    aria-expanded="false"
                    aria-controls="site-menu"
                    aria-label="Menüyü aç">
                <span class="site-header__menu-toggle-box" aria-hidden="true">
                    <span class="site-header__menu-bar"></span>
                    <span class="site-header__menu-bar"></span>
                    <span class="site-header__menu-bar"></span>
                </span>
            </button>

            <div class="site-header__tools site-header__tools--desktop">
                @if(siteSettings.HeaderNavLinks != null || home != null) {
                    <nav class="site-header__nav" aria-label="Kısa bağlantılar">
                        @if(siteSettings.HeaderNavLinks != null) {
                            @foreach(var link in siteSettings.HeaderNavLinks) {
                                <a class="site-header__nav-link" href="@link.Url" target="@link.Target">@link.Name</a>
                            }
                        }

                        @if (home != null) {
                            <a class="site-header__home-link" href="@home.Url()" aria-label="Anasayfa">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M3 10.5 12 3l9 7.5"></path>
                                    <path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5"></path>
                                </svg>
                            </a>
                        }
                    </nav>
                }
                

                @if(siteSettings.HeaderSocialLinks != null) {
                    <div class="site-social" aria-label="Sosyal medya">
                        @foreach(var link in siteSettings.HeaderSocialLinks) {
                            <a class="site-social__link" href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="@link.Name">
                                <img class="site-social__icon" src="~/images/@(link.Network)-white.svg" alt="@link.Name" width="16" height="16" />
                            </a>
                        }
                    </div>
                }

                @*<details class="site-lang">
                    <summary class="site-lang__toggle" aria-label="Dil seçin">
                        <span class="site-lang__current">@System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName.ToUpper()</span>
                        <span class="site-lang__caret" aria-hidden="true"></span>
                    </summary>
                    <div class="site-lang__panel" role="group" aria-label="Diller">
                        <a class="site-lang__option site-lang__option--active"
                           href="@Model.Url(System.Threading.Thread.CurrentThread.CurrentCulture.Name)"
                           aria-current="true">
                            @System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName.ToUpper()
                        </a>

                        @foreach (var language in LanguageService.GetAllAsync().Result)
                        {
                            @if (language?.CultureInfo?.Name != System.Threading.Thread.CurrentThread.CurrentCulture.Name)
                            {
                                <a class="site-lang__option" href="@Model.Url(language?.CultureInfo?.Name)">@language?.CultureInfo?.TwoLetterISOLanguageName.ToUpper()</a>
                            }
                        }
                    </div>
                </details>*@
            </div>
        </div>
    </div>

    <div class="header-search">
        <div class="header-search__inner">
            <form method="get" action="#" class="dict-search-form dict-search-form--compact" data-dictionary-search-url="@dictionarySearchUrl" data-dictionary-no-results-url="@dictionaryNoResultsUrl" autocomplete="off">
                <input type="hidden" name="direction" value="en-tr">
                <div class="topbar-search-inline hero-search-row">
                    <details class="dict-direction-select dict-direction-select--compact">
                        <summary class="dict-direction-select__toggle">
                            <span class="dict-direction-select__label" data-direction-label>@Umbraco.GetDictionaryValue("Common.English-Turkish")</span>
                            <span class="dict-direction-select__caret" aria-hidden="true"></span>
                        </summary>
                        <div class="dict-direction-select__menu dict-direction-tabs" role="group" aria-label="@Umbraco.GetDictionaryValue("Common.English-Turkish")">
                            <button type="button" class="tab-btn active" data-direction="en-tr">@Umbraco.GetDictionaryValue("Common.English-Turkish")</button>
                            <button type="button" class="tab-btn" data-direction="tr-en">@Umbraco.GetDictionaryValue("Common.Turkish-English")</button>
                        </div>
                    </details>

                    <div class="search-wrap">
                        <div class="search-shell">
                            <input type="text" name="q" autocomplete="off" placeholder="@Umbraco.GetDictionaryValue("Common.English-Turkish")" required>
                            <div class="search-shell__actions">
                                <button type="button" class="search-clear dict-search-clear" hidden aria-label="@Umbraco.GetDictionaryValue("Common.MetniTemizle")">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                                <span class="search-shell__divider" aria-hidden="true"></span>
                                <button class="search-submit" type="submit" aria-label="Ara">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="11" cy="11" r="8" />
                                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <ul class="dict-search-suggestions suggestions" role="listbox" aria-label="@Umbraco.GetDictionaryValue("Common.AramaOnerileri")" hidden></ul>
                        <template class="dictionary-suggestion-item-template">
                            <li role="option"><a href="#"></a></li>
                        </template>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="site-menu" class="site-menu" hidden aria-hidden="true">
        <div class="site-menu__backdrop" data-site-menu-close tabindex="-1"></div>
        <aside class="site-menu__panel" role="dialog" aria-modal="true" aria-labelledby="site-menu-title">
            <div class="site-menu__head">
                <p id="site-menu-title" class="site-menu__title">Menü</p>
                <button type="button" class="site-menu__close" data-site-menu-close aria-label="Menüyü kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="site-menu__body">
                <div class="site-menu__lang">
                    <a class="site-menu__lang-btn site-menu__lang-btn--active"
                       href="@Model.Url(System.Threading.Thread.CurrentThread.CurrentCulture.Name)"
                       aria-current="true">
                        @System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName.ToUpper()
                    </a>

                    @foreach (var language in LanguageService.GetAllAsync().Result)
                    {
                        @if (language?.CultureInfo?.Name != System.Threading.Thread.CurrentThread.CurrentCulture.Name)
                        {
                            <a class="site-menu__lang-btn" href="@Model.Url(language?.CultureInfo?.Name)">@language?.CultureInfo?.TwoLetterISOLanguageName.ToUpper()</a>
                        }
                    }
                </div>

                @if(siteSettings.HeaderNavLinks != null || home != null) {
                    <nav class="site-menu__nav" aria-label="Kısa bağlantılar">
                        @if(siteSettings.HeaderNavLinks != null) {
                            @foreach(var link in siteSettings.HeaderNavLinks) {
                                <a class="site-menu__link" href="@link.Url" target="@link.Target">@link.Name</a>
                            }
                        }

                        @if (home != null) {
                            <a class="site-menu__link site-menu__link--home" href="@home.Url()">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M3 10.5 12 3l9 7.5"></path>
                                    <path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5"></path>
                                </svg>
                                Anasayfa
                            </a>
                        }
                    </nav>
                }

                @if(siteSettings.HeaderSocialLinks != null) {
                    <div class="site-menu__social">
                        @foreach(var link in siteSettings.HeaderSocialLinks) {
                            <a class="site-menu__social-link" href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="@link.Name">
                                <img src="~/images/@(link.Network)-white.svg" alt="@link.Name" width="22" height="22" />
                            </a>
                        }
                    </div>
                }
            </div>
        </aside>
    </div>
</header>
