@using Umbraco.Cms.Core.Services
@inherits UmbracoViewPage
@inject ILanguageService LanguageService

@{
    var siteSettings = Model.GetSiteSettings();
    var home = Model.GetMainPage();
}

<header class="site-header">
    <div class="site-header__inner page">
        @if (home != null)  {
            <a class="site-header__logo" href="@home.Url()">
                @if(siteSettings.HeaderLogo != null) {
                <img src="@siteSettings.HeaderLogo.Url()" alt="@siteSettings.HeaderLogo.Name" height="48" />

                }
            </a>
        }


        <div class="site-header__end">
            <button type="button"
                    class="site-header__menu-toggle"
                    data-site-menu-open
                    aria-expanded="false"
                    aria-controls="site-menu"
                    aria-label="Menüyü aç">
                <span class="site-header__menu-toggle-box" aria-hidden="true">
                    <span class="site-header__menu-bar"></span>
                    <span class="site-header__menu-bar"></span>
                    <span class="site-header__menu-bar"></span>
                </span>
            </button>

            <div class="site-header__tools site-header__tools--desktop">
                @if(siteSettings.HeaderNavLinks != null) {
                    <nav class="site-header__nav" aria-label="Kısa bağlantılar">
                        @foreach(var link in siteSettings.HeaderNavLinks) {
                            <a class="site-header__nav-link" href="@link.Url" target="@link.Target">@link.Name</a>
                        }
                </nav>
                }
                

                @if(siteSettings.HeaderSocialLinks != null) {
                    <div class="site-social" aria-label="Sosyal medya">
                        @foreach(var link in siteSettings.HeaderSocialLinks) {
                            <a class="site-social__link" href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="@link.Name">
                                <img class="site-social__icon" src="~/images/@(link.Network)-white.svg" alt="@link.Name" width="16" height="16" />
                            </a>
                        }
                    </div>
                }

                @*<details class="site-lang">
                    <summary class="site-lang__toggle" aria-label="Dil seçin">
                        <span class="site-lang__current">@System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName.ToUpper()</span>
                        <span class="site-lang__caret" aria-hidden="true"></span>
                    </summary>
                    <div class="site-lang__panel" role="group" aria-label="Diller">
                        <a class="site-lang__option site-lang__option--active"
                           href="@Model.Url(System.Threading.Thread.CurrentThread.CurrentCulture.Name)"
                           aria-current="true">
                            @System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName.ToUpper()
                        </a>

                        @foreach (var language in LanguageService.GetAllAsync().Result)
                        {
                            @if (language?.CultureInfo?.Name != System.Threading.Thread.CurrentThread.CurrentCulture.Name)
                            {
                                <a class="site-lang__option" href="@Model.Url(language?.CultureInfo?.Name)">@language?.CultureInfo?.TwoLetterISOLanguageName.ToUpper()</a>
                            }
                        }
                    </div>
                </details>*@
            </div>
        </div>
    </div>

    <div id="site-menu" class="site-menu" hidden aria-hidden="true">
        <div class="site-menu__backdrop" data-site-menu-close tabindex="-1"></div>
        <aside class="site-menu__panel" role="dialog" aria-modal="true" aria-labelledby="site-menu-title">
            <div class="site-menu__head">
                <p id="site-menu-title" class="site-menu__title">Menü</p>
                <button type="button" class="site-menu__close" data-site-menu-close aria-label="Menüyü kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="site-menu__body">
                <div class="site-menu__lang">
                    <a class="site-menu__lang-btn site-menu__lang-btn--active"
                       href="@Model.Url(System.Threading.Thread.CurrentThread.CurrentCulture.Name)"
                       aria-current="true">
                        @System.Threading.Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName.ToUpper()
                    </a>

                    @foreach (var language in LanguageService.GetAllAsync().Result)
                    {
                        @if (language?.CultureInfo?.Name != System.Threading.Thread.CurrentThread.CurrentCulture.Name)
                        {
                            <a class="site-menu__lang-btn" href="@Model.Url(language?.CultureInfo?.Name)">@language?.CultureInfo?.TwoLetterISOLanguageName.ToUpper()</a>
                        }
                    }
                </div>

                @if(siteSettings.HeaderNavLinks != null) {
                    <nav class="site-menu__nav" aria-label="Kısa bağlantılar">
                        @foreach(var link in siteSettings.HeaderNavLinks) {
                            <a class="site-menu__link" href="@link.Url" target="@link.Target">@link.Name</a>
                        }
                    </nav>
                }

                @if(siteSettings.HeaderSocialLinks != null) {
                    <div class="site-menu__social">
                        @foreach(var link in siteSettings.HeaderSocialLinks) {
                            <a class="site-menu__social-link" href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="@link.Name">
                                <img src="~/images/@(link.Network)-white.svg" alt="@link.Name" width="22" height="22" />
                            </a>
                        }
                    </div>
                }
            </div>
        </aside>
    </div>
</header>
