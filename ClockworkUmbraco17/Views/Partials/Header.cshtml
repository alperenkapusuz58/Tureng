<header class="site-header">
    <div class="site-header__inner page">
        <a class="site-header__logo" href="/">
            <img src="~/images/logo.png" alt="Logo" height="48" />
        </a>

        <div class="site-header__end">
            <button type="button"
                    class="site-header__menu-toggle"
                    data-site-menu-open
                    aria-expanded="false"
                    aria-controls="site-menu"
                    aria-label="Menüyü aç">
                <span class="site-header__menu-toggle-box" aria-hidden="true">
                    <span class="site-header__menu-bar"></span>
                    <span class="site-header__menu-bar"></span>
                    <span class="site-header__menu-bar"></span>
                </span>
            </button>

            <div class="site-header__tools site-header__tools--desktop">
                <nav class="site-header__nav" aria-label="Kısa bağlantılar">
                    <a class="site-header__nav-link" href="#">Yardım</a>
                </nav>

                <div class="site-social" aria-label="Sosyal medya">
                    <a class="site-social__link" href="#" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                        <img class="site-social__icon" src="~/images/facebook-white.svg" alt="" width="16" height="16" />
                    </a>
                    <a class="site-social__link" href="#" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <img class="site-social__icon" src="~/images/instagram-white.svg" alt="" width="16" height="16" />
                    </a>
                </div>

                <details class="site-lang">
                    <summary class="site-lang__toggle" aria-label="Dil seçin">
                        <span class="site-lang__current">TR</span>
                        <span class="site-lang__caret" aria-hidden="true"></span>
                    </summary>
                    <div class="site-lang__panel" role="group" aria-label="Diller">
                        <a class="site-lang__option site-lang__option--active" href="#" aria-current="true">TR</a>
                        <a class="site-lang__option" href="#">EN</a>
                    </div>
                </details>
            </div>
        </div>
    </div>

    <div id="site-menu" class="site-menu" hidden aria-hidden="true">
        <div class="site-menu__backdrop" data-site-menu-close tabindex="-1"></div>
        <aside class="site-menu__panel" role="dialog" aria-modal="true" aria-labelledby="site-menu-title">
            <div class="site-menu__head">
                <p id="site-menu-title" class="site-menu__title">Menü</p>
                <button type="button" class="site-menu__close" data-site-menu-close aria-label="Menüyü kapat">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="site-menu__body">
                <div class="site-menu__lang">
                    <a class="site-menu__lang-btn site-menu__lang-btn--active" href="#" aria-current="true">TR</a>
                    <a class="site-menu__lang-btn" href="#">EN</a>
                </div>

                <nav class="site-menu__nav" aria-label="Kısa bağlantılar">
                    <a class="site-menu__link" href="#">Yardım</a>
                </nav>

                <div class="site-menu__social">
                    <a class="site-menu__social-link" href="#" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                        <img src="~/images/facebook-white.svg" alt="" width="22" height="22" />
                    </a>
                    <a class="site-menu__social-link" href="#" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <img src="~/images/instagram-white.svg" alt="" width="22" height="22" />
                    </a>
                </div>
            </div>
        </aside>
    </div>
</header>
