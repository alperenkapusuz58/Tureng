@using Umbraco.Cms.Core.Services
@inherits UmbracoViewPage
@inject ILanguageService LanguageService

@{
    var siteSettings = Model.GetSiteSettings();
    var home = Model.GetMainPage();
}

<footer class="site-footer">
    <div class="site-footer__top page">
        @if (siteSettings.FooterLogo != null)
        {
            <a class="site-footer__logo" href="@home.Url()">
                @if (siteSettings.FooterLogo != null)
                {
                    <img src="@siteSettings.FooterLogo.Url()" alt="@siteSettings.FooterLogo.Name" width="52" height="52" />
                }
            </a>
        }

        @if (siteSettings.FooterNavLinks != null)
        {
            <nav class="site-footer__groups" aria-label="Alt bağlantılar">
                @for (var i = 0; i < siteSettings.FooterNavLinks.Count; i++)
                {
                    var item = siteSettings.FooterNavLinks.ElementAt(i).Content as TitleMultiUrlItem;

                    <section class="site-footer__group" aria-labelledby="footer-@(item?.Title.ToUrl())">
                        <h2 id="footer-@(item?.Title?.ToUrl())" class="site-footer__heading">@item?.Title</h2>
                        @if(item?.MultiUrl != null) {
                        <ul class="site-footer__list">
                            @foreach (var link in item?.MultiUrl)
                                {
                                    <li><a class="site-footer__link" href="@link.Url" target="@link.Target">@link.Name</a></li>
                                }
                            </ul>
                        }
                    </section>
                }

            </nav>
        }

    </div>
    <div class="site-footer__copy-bar">
        <div class="page">
            <p class="site-footer__copy">© @DateTime.UtcNow.Year @Umbraco.GetDictionaryValue("Copyright")</p>
        </div>
    </div>
</footer>
