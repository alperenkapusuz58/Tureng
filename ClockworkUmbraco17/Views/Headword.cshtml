@inherits UmbracoViewPage<Headword>
@using ClockworkUmbraco.Controllers
@using ClockworkUmbraco.Extensions
@using ClockworkUmbraco.Helpers
@{
    Layout = "Layout.cshtml";

    var searchDirection = Context.Request.Query["direction"].ToString();
    if (string.IsNullOrWhiteSpace(searchDirection))
    {
        searchDirection = "en-tr";
    }

    var ttsLanguage = string.Equals(searchDirection, "tr-en", StringComparison.OrdinalIgnoreCase) ? "tr-TR" : "en-US";
    var dictionaryAudioUrl = "/api/dictionary/audio";
}

@section styles {
    <style>
        .phrase-item.is-focused {
            outline: 2px solid rgba(36, 59, 122, 0.45);
            outline-offset: 4px;
            border-radius: 8px;
            background: rgba(255, 214, 0, 0.12);
            scroll-margin-top: 120px;
        }

        .pos-group-header .pos-audio-btn {
            margin-left: auto;
            flex: 0 0 auto;
        }
    </style>
}

<div class="dictionary-page" data-dictionary-audio-url="@dictionaryAudioUrl">
    <header class="dict-entry-head" aria-labelledby="dict-entry-title">
        <div class="dict-entry-head__ad">
            <aside class="dict-page-ad" role="complementary" aria-label="Reklam">
                <div id="dictionary-entry-ad" class="dict-page-ad__slot"></div>
            </aside>
        </div>
    </header>
    <div class="page">
        <section>

            @if (Model?.PartofSpeech != null && Model.PartofSpeech.Any())
            {
                @for (var i = 0; i < Model.PartofSpeech.Count(); i++)
                {

                    var category = Model.PartofSpeech.ElementAt(i).Content as SenseCategoryItem;

                    <div class="pos-group">
                        <div class="pos-group-header">
                            <span class="pos-lemma">@Model.Word</span>

                            <span class="pos-tag">@category?.PartOfSpeech</span>

                            <button class="ex-btn listen-btn pos-audio-btn" type="button" data-text="@Model.Word" data-language="@ttsLanguage" data-source-type="word" aria-label="@Model.Word kelimesini dinle">
                                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                                </svg>
                            </button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(category?.IrregularForms))
                        {
                            <div class="irregular-forms">@category?.IrregularForms</div>
                        }

                        @if(category?.Items != null && category.Items.Any())
                        {
                            var senseCount = category.Items.Count();

                            <ol class="sense-list">

                                @for(var j = 0; j < senseCount; j++)
                                {
                                    var item = category.Items.ElementAt(j).Content as SenseItem;
                                    var sentenceHtml = item?.Sentence?.ToString() ?? string.Empty;
                                    var sentenceText = System.Text.RegularExpressions.Regex.Replace(sentenceHtml, "<.*?>", " ").Trim();
                                    var dotIndex = sentenceText.IndexOf('.');
                                    if (dotIndex >= 0)
                                    {
                                        sentenceText = sentenceText.Substring(0, dotIndex).Trim();
                                    }

                                    <li class="sense-item">
                                        @if (senseCount > 1)
                                        {
                                            <span class="sense-num">@(j + 1)</span>
                                        }
                                        <div class="sense-body">
                                            <div class="translation-line">@item?.Translation</div>

                                            <div class="example-block">
                                                @await Html.PartialAsync("IsolatedRte", sentenceHtml)

                                                <button class="ex-btn listen-btn" type="button" data-text="@sentenceText" data-language="@ttsLanguage" data-source-type="sentence" aria-label="Dinle">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                                        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                                                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                                                    </svg>
                                                </button>

                                            </div>

                                        </div>
                                    </li>
                                }
                            </ol>
                        }
                    </div>
                }
            }


            @if(Model?.Idioms != null && Model.Idioms.Any())
            {
                <div class="phrases-section">

                    <div class="phrases-title">@Umbraco.GetDictionaryValue("Common.DeyimlerVeAtasozleri")</div>

                    @for (var i = 0; i < Model?.Idioms.Count(); i++)
                    {
                        var item = Model?.Idioms.ElementAt(i).Content as IdiomsAndProverbsItem;
                        var phraseSentenceHtml = item?.Sentence?.ToString() ?? string.Empty;
                        var phraseSentenceText = System.Text.RegularExpressions.Regex.Replace(phraseSentenceHtml, "<.*?>", " ").Trim();

                        <div class="phrase-item" id="@PhraseAnchor.ToHash(item?.Phrase)" data-phrase="@item?.Phrase">
                            <span class="phrase-text">@item?.Phrase</span>

                            @if(item.Items != null && item.Items.Any()){
                                var phraseSenseCount = item.Items.Count();

                                @for(var j = 0; j < phraseSenseCount; j++){

                                    var itemContent = item.Items.ElementAt(j).Content as SenseItem;
                                    var innerSentenceHtml = itemContent?.Sentence?.ToString() ?? string.Empty;
                                    var innerSentenceText = System.Text.RegularExpressions.Regex.Replace(innerSentenceHtml, "<.*?>", " ").Trim();
                                    var dotIndex = innerSentenceText.IndexOf('.');
                                    if (dotIndex >= 0)
                                    {
                                        innerSentenceText = innerSentenceText.Substring(0, dotIndex).Trim();
                                    }

                                    <div class="phrase-sense">
                                        @if (phraseSenseCount > 1)
                                        {
                                            <span class="sense-num">@(j + 1)</span>
                                        }
                                        <div class="phrase-sense-body">
                                            <div class="phrase-tr">@itemContent?.Translation</div>
                                            <div class="phrase-example">
                                                @await Html.PartialAsync("IsolatedRte", innerSentenceHtml)

                                                <button class="ex-btn listen-btn" type="button" data-text="@innerSentenceText" data-language="@ttsLanguage" data-source-type="sentence" aria-label="Dinle">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                                        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                                                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            

                        </div>
                    }
                </div>
            }


            @if (Model?.PhrasalVerbs != null && Model.PhrasalVerbs.Any())
            {
                <div class="phrases-section">

                    <div class="phrases-title">@Umbraco.GetDictionaryValue("Common.PhrasalVerbs")</div>

                    @for (var i = 0; i < Model?.PhrasalVerbs.Count(); i++)
                    {
                        var item = Model?.PhrasalVerbs.ElementAt(i).Content as IdiomsAndProverbsItem;

                        <div class="phrase-item" id="@PhraseAnchor.ToHash(item?.Phrase)" data-phrase="@item?.Phrase">
                            <span class="phrase-text">@item?.Phrase</span>

                            @if (item?.Items != null && item.Items.Any())
                            {
                                var phraseSenseCount = item.Items.Count();

                                @for (var j = 0; j < phraseSenseCount; j++)
                                {
                                    var itemContent = item.Items.ElementAt(j).Content as SenseItem;
                                    var innerSentenceHtml = itemContent?.Sentence?.ToString() ?? string.Empty;
                                    var innerSentenceText = System.Text.RegularExpressions.Regex.Replace(innerSentenceHtml, "<.*?>", " ").Trim();
                                    var dotIndex = innerSentenceText.IndexOf('.');
                                    if (dotIndex >= 0)
                                    {
                                        innerSentenceText = innerSentenceText.Substring(0, dotIndex).Trim();
                                    }

                                    <div class="phrase-sense">
                                        @if (phraseSenseCount > 1)
                                        {
                                            <span class="sense-num">@(j + 1)</span>
                                        }
                                        <div class="phrase-sense-body">
                                            <div class="phrase-tr">@itemContent?.Translation</div>
                                            <div class="phrase-example">
                                                @await Html.PartialAsync("IsolatedRte", innerSentenceHtml)

                                                <button class="ex-btn listen-btn" type="button" data-text="@innerSentenceText" data-language="@ttsLanguage" data-source-type="sentence" aria-label="Dinle">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                                                        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                                                        <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }

                        </div>
                    }
                </div>
            }


        </section>
    </div>
</div>

@section scripts {
    <script src="~/js/phrase-focus.js" asp-append-version="true"></script>
    <script src="~/js/listen-audio.js" asp-append-version="true"></script>
}
